{
  "name": "milagre-live-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps packages",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev": "npm run dev --workspace @milagre-live/web",
    "deploy": "npm run deploy --workspace @milagre-live/web",
    "e2e": "npm run e2e --workspace @milagre-live/web"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
